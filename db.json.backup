  "notes": [
    {
      "id": "n001",
      "title": "Sunucu Bakım Notları",
      "content": "VPS sunucusunda haftalık güncelleme yapıldı. Tüm servisler çalışıyor. Disk kullanımı %45 seviyesinde.",
      "createdAt": "2025-12-09T08:15:00.000Z",
      "userId": "2"
    },
    {
      "id": "n002",
      "title": "Domain Yenileme Hatırlatıcısı",
      "content": "example.com domaini 15 gün sonra sona eriyor. GoDaddy üzerinden yenileme yapılmalı.",
      "createdAt": "2025-12-08T10:20:00.000Z",
      "userId": "2"
    },
    {
      "id": "n003",
      "title": "Veritabanı Yedekleme",
      "content": "MySQL veritabanının son yedeği alındı. Backup dosyası /backups/db_2025_12_07.sql konumunda.",
      "createdAt": "2025-12-07T14:30:00.000Z",
      "userId": "2"
    },
    {
      "id": "n004",
      "title": "SSL Sertifika Güncellemesi",
      "content": "Let's Encrypt SSL sertifikası otomatik olarak yenilendi. Tüm siteler HTTPS üzerinden erişilebilir.",
      "createdAt": "2025-12-06T09:45:00.000Z",
      "userId": "2"
    },
    {
      "id": "n005",
      "title": "WordPress Eklenti Güncellemeleri",
      "content": "Yoast SEO, WooCommerce ve Contact Form 7 eklentileri güncellendi. Test edildi, sorun yok.",
      "createdAt": "2025-12-05T16:10:00.000Z",
      "userId": "2"
    },
    {
      "id": "n006",
      "title": "Mail Sunucu Ayarları",
      "content": "SMTP ayarları yapılandırıldı. Port: 587, TLS aktif. Test maili başarıyla gönderildi.",
      "createdAt": "2025-12-04T11:25:00.000Z",
      "userId": "2"
    },
    {
      "id": "n007",
      "title": "FTP Erişim Sorunu Çözümü",
      "content": "Passive mode aktif edildi. Firewall ayarları güncellendi. FTP erişimi sorunsuz çalışıyor.",
      "createdAt": "2025-12-03T13:40:00.000Z",
      "userId": "2"
    },
    {
      "id": "n008",
      "title": "Güvenlik Taraması Sonuçları",
      "content": "Malware taraması tamamlandı. Tehdit bulunamadı. Wordfence eklentisi güncel.",
      "createdAt": "2025-12-02T15:55:00.000Z",
      "userId": "2"
    },
    {
      "id": "n009",
      "title": "Disk Alanı Optimizasyonu",
      "content": "Eski log dosyaları temizlendi. 5GB alan boşaltıldı. Disk kullanımı optimize edildi.",
      "createdAt": "2025-12-01T10:30:00.000Z",
      "userId": "2"
    },
    {
